#
# Prerequisites:
#   (*) Ensure you are running from a folder that contains the helmfile.d folder
#
# Usage:
#   (*) Install: helmfile sync --state-values-file <path-to-your-values-customization-file (customization file advised name => singular-singular.clusterKit.yaml)>
#     Note: Another option is to use the --values flag instead of the --state-values-file flag
#     Ensure the following:
#       1. Define an environment variable as follows:
#         Name: AS360_KNI_JSON_CONFIG_AS_BASE64
#         Value: The designated registry docker config file, encoded in Base64
#         Name: SCA_AUTOUPDATER_REGISTRY_ADDRESS
#         Value: The address of the registry to be used by the SCA AutoUpdater.
#         This variable is OPTIONAL and  only needed needed only if you want the auto-updater feature to be enabled.
#         Name: SCA_AUTOUPDATER_REGISTRY_USERNAME
#         Value: The username of the registry to be used by the SCA AutoUpdater.
#         This variable is OPTIONAL and needed only if you want the auto-updater feature to be enabled.
#         Name: SCA_AUTOUPDATER_REGISTRY_PASSWORD
#         Value: The password of the registry to be used by the SCA AutoUpdater.
#         This variable is OPTIONAL and needed only if you want the auto-updater feature to be enabled.
#       2. Verify an already configured docker config file is residing under the home folder of the user (e.g., ~/.docker/config.json)
#       3. In case the environment variables need to be changed, add another parameter to the command line:
#         --state-values-file <path-to-your-environment-customization-file (customization file advised name => singular-singular.clusterKit.yaml.gotmpl)>
#         3.1. An example of the file content:
            # singular-singular.clusterKit.yaml.gotmpl:
            # -----------------------------------------
            # environment:
            #   helmRepositoryName: "my-custom-helm"
            #   helmRepositoryAddress: "new-helm-registry.local"
            #   helmRepositoryContext: "custom-project/charts"
            #   helmRepositoryOciEnabled: true/false
#       4. Values for the below variables are a pre-requisite and needs to be populated in helmfile.d/scaKit.yaml:
#         Name: requestedCapacity
#         Value: The customer's K8S shared storage designated size, to be calculated before installation
#         Name: storageClassName
#         Value: The customer's K8S shared storage designated file path
#         Name: ConnectionStrings__ScaEngineDatabase
#         Value: The connection string for the SCA Engine database
#         Name: ConnectionStrings__ScaAggregationDB
#         Value: The connection string for the SCA Aggregate database
#
#   (*) Uninstall: helmfile destroy  --state-values-file <path-to-your-values-customization-file (customization file advised name => singular-singular.clusterKit.yaml)>
#   (*) Control the namespace: add the following clause '-n <namespace>' to the helmfile command
#
environments:
  default:
    values:
    - global:
        multiTenantDeploymentDifferentiator: ''
        isNonProductionDeployment: false
        runtime:
          siteName: singular
          clusterName: singular
    - environment:
        ### ~~~ OVERRIDABLE-SECTION-BEGIN ~~~
        helmRepositoryName: hclcr
        helmRepositoryAddress: hclcr.io
        helmRepositoryContext: appscan360/as360-k8s-helm-packages
        helmRepositoryOciEnabled: true
        releaseName: appscan360-sca
        releaseVersion: 2.3.0
        releaseNamespace: hcl-appscan-sca
        dockerRegistryAddress: hclcr.io
        dockerRegistryContext: "appscan360/as360-k8s-docker-images"
        autoupdaterImageTag: "newest-build-2.3.0"
        autoscaling: "false"
        ### ~~~ OVERRIDABLE-SECTION-END ~~~

---
helmDefaults:
  cleanupOnFail: true
  wait: true
  waitForJobs: true
  timeout: 1800
  createNamespace: true
  #deleteWait: true
  syncArgs:
  - "--rollback-on-failure"
  - "--server-side=true"
  - "--force-conflicts"
  - "--reset-values"
  # Note: The destroyArgs section isn't a valid section in this context!!!
  # destroyArgs:
  # - "--skip-charts"
  # - "--skip-deps"
  # - "--skip-refresh"

repositories:
- name: {{ .Values.environment.helmRepositoryName }}
  url: {{ .Values.environment.helmRepositoryAddress }}
  oci: {{ .Values.environment.helmRepositoryOciEnabled }}
---

{{- $helmRepoRegistry := default "" -}}
{{- $helmRepoContext := default "" -}}

{{- if hasKey .Values.environment "helmRepositoryAddress" }}
  {{- $helmRepoRegistry = .Values.environment.helmRepositoryAddress | default $helmRepoRegistry -}}
{{- end }}

{{- if hasKey .Values.environment "helmRepositoryContext" }}
  {{- $helmRepoContext = .Values.environment.helmRepositoryContext | default $helmRepoContext -}}
{{- end }}

{{- $workload := index .Values.global "workload" | default dict -}}
{{- $container := index $workload "container" | default dict -}}
{{- $image := index $container "image" | default dict -}}
{{- $workloadImageRegistry := index $image "registry" | default .Values.environment.dockerRegistryAddress -}}
{{- $workloadImageRepository := index $image "repository" | default .Values.environment.dockerRegistryContext -}}

{{- $openTelemetryEndpoint := default "" -}}
{{- $openTelemetryEnable := default "false" -}}
{{- $openTelemetryEnableLogs := default "false" -}}
{{- $openTelemetryEnableMetrics := default "false" -}}
{{- $upstreamProxyHost := default "" -}}
{{- $upstreamProxyPort := default "" -}}
{{- $upstreamProxyUsername := default "" -}}
{{- $upstreamProxyPassword := default "" -}}

{{- if hasKey .Values.global.configuration "disclosed" }}
  {{- $openTelemetryEndpoint = .Values.global.configuration.disclosed.openTelemetryEndpoint | default $openTelemetryEndpoint -}}
  {{- $openTelemetryEnableLogs = .Values.global.configuration.disclosed.openTelemetryEnableLogs | default $openTelemetryEnableLogs -}}
  {{- $openTelemetryEnableMetrics = .Values.global.configuration.disclosed.openTelemetryEnableMetrics | default $openTelemetryEnableMetrics -}}
  {{- if not (empty $openTelemetryEndpoint) }}
    {{- $openTelemetryEnable = "true" -}}
  {{- else }}
    {{- $openTelemetryEnableMetrics = "false" -}}
  {{- end }}
{{- end }}

{{- if hasKey .Values.global.configuration.disclosed "upstreamProxyHost" }}
  {{- $upstreamProxyHost = .Values.global.configuration.disclosed.upstreamProxyHost | default $upstreamProxyHost -}}
  {{- $upstreamProxyPort = .Values.global.configuration.disclosed.upstreamProxyPort | default $upstreamProxyPort -}}
  {{- $upstreamProxyUsername = .Values.global.configuration.disclosed.upstreamProxyUsername | default $upstreamProxyUsername -}}
{{- end }}

{{- if hasKey .Values.global.configuration "confidential" }}
  {{- $upstreamProxyPassword = .Values.global.configuration.confidential.upstreamProxyPassword | default $upstreamProxyPassword -}}
{{- end }}




releases:
- name: 'scaservices'
  namespace: '{{ .Namespace | default .Values.environment.releaseNamespace }}'
  hooks:
    - events: ["preuninstall"]
      command: "sh"
      args:
        - "-c"
        - |
          echo "Patching CRDs to remove finalizers and performing cleanup tasks before uninstall..."
          # Delete multiple CRDs
          kubectl patch crd scaledobjects.keda.sh -n '{{ .Namespace | default .Values.environment.releaseNamespace }}' -p '{"metadata":{"finalizers":[]}}' --type=merge || true

          # Patch a resource before removal (example: remove finalizers)
          kubectl delete scaledobject --all -n '{{ .Namespace | default .Values.environment.releaseNamespace }}' || true

    - events: ["postuninstall"]
      command: "sh"
      args:
        - "-c"
        - |
          echo "Patching CRDs to remove finalizers and performing cleanup namespace tasks..."
          kubectl patch crd triggerauthentications.keda.sh -n '{{ .Namespace | default .Values.environment.releaseNamespace }}' -p '{"metadata":{"finalizers":[]}}' --type=merge || true
          kubectl patch crd imageupdaters.argocd-image-updater.argoproj.io -n '{{ .Namespace | default .Values.environment.releaseNamespace }}' -p '{"metadata":{"finalizers":[]}}' --type=merge || true
          # Run any other cleanup commands
          # Do not delete the namespace as part of the cleanup to avoid accidental removal of other services
          # kubectl delete namespace '{{ .Namespace | default .Values.environment.releaseNamespace }}' --ignore-not-found=true

{{- if not (empty $helmRepoRegistry) }}
  chart: oci://{{ $helmRepoRegistry }}/{{ $helmRepoContext }}/sca
{{- else }}
  chart: "{{ .Values.environment.helmRepositoryName }}/{{ .Values.environment.helmRepositoryContext }}/sca"
{{- end }}

  version: 2.3.0-20261110093330995-fed-release-rhel-ubi-9
  values:
{{/*
  - helmFileCustomizations/{{ .Values.global.runtime.siteName }}-{{ .Values.global.runtime.clusterName }}.clusterKit.yaml
*/}}
  # Converts all your --state-values directly into Helm chart values (replacement of the line above)
  - {{ toYaml .Values | nindent 4 }}
  - global:
      ca:
        intermediate:
          enabled: false
        seed:
          enabled: false

      customer:
        certificate:
          ca:
            # CUSTOMIZE_ME:
            # Indication whether to use customer given CA certificates, or not
            enabled: false
          ingress:
            # CUSTOMIZE_ME:
            # Indication whether to use a customer given certificate as the applicable external (out-of-cluster) micro services ingresses certificates, or not
            enabled: false

      workload:
        container:
          image:
{{- if not (empty $helmRepoRegistry) }}
            registry: {{ $workloadImageRegistry }}
            repository: {{ $workloadImageRepository }}
{{- else }}
            registry: {{ .Values.environment.dockerRegistryAddress }}
            repository: {{ .Values.environment.dockerRegistryContext }}
{{- end }}

            pullSecrets:
            - as360-secret
        dockerPrivateRegistry:
          secret:
            data:
{{- if env "AS360_KNI_JSON_CONFIG_AS_BASE64" }}
              jsonConfigAsBase64: {{ env "AS360_KNI_JSON_CONFIG_AS_BASE64" }}
              jsonConfigAsBase64Harbor: {{ env "AS360_KNI_JSON_CONFIG_AS_BASE64" }}
{{- else }}
              jsonConfigAsBase64: {{ readFile (printf "%s/%s" (env "HOME") ".docker/config.json") | b64enc }}
              jsonConfigAsBase64Harbor: {{ readFile (printf "%s/%s" (env "HOME") ".docker/config.json") | b64enc }}
{{- end }}
  - rabbitmq:
      image:
{{- if not (empty $helmRepoRegistry) }}
        registry: {{ $workloadImageRegistry }}
        repository: {{ $workloadImageRepository }}/rabbitmq
{{- else }}
        registry: {{ .Values.environment.dockerRegistryAddress }}
        repository: {{ .Values.environment.dockerRegistryContext }}/rabbitmq
{{- end }}
        tag: 4.2.2-debian-12-r1-p180

        pullSecrets:
          - as360-secret
      volumePermissions:
        image:
          pullSecrets:
            - as360-secret

  - scadpr:
      common:
        dockerPrivateRegistry:
          secret:
            name: as360-secret
            enabled: false
            helmenabled: true
  - argo-cd:
      global:
        image:
{{- if not (empty $helmRepoRegistry) }}
          repository: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/argocd
{{- else }}
          repository: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/argocd
{{- end }}
          tag: "v3.4.2-p180"

        imagePullSecrets:
        - name: as360-secret
      dex:
        image:
{{- if not (empty $helmRepoRegistry) }}
          repository: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/dex
{{- else }}
          repository: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/dex
{{- end }}
          tag: v2.45.1

        imagePullSecrets:
        - name: as360-secret
      redis:
        enabled: true
        image:
{{- if not (empty $helmRepoRegistry) }}
          repository: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/redis
{{- else }}
          repository: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/redis
{{- end }}
          tag: 8.2.2-alpine-p180

        imagePullSecrets:
        - name: as360-secret
        exporter:
          image:
{{- if not (empty $helmRepoRegistry) }}
            repository: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/redis_exporter
{{- else }}
            repository: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/redis_exporter
{{- end }}
            tag: 8.2.2-alpine-p180

          imagePullSecrets:
          - name: as360-secret
      redis-ha:
        image:
{{- if not (empty $helmRepoRegistry) }}
          repository: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/redis
{{- else }}
          repository: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/redis
{{- end }}

        imagePullSecrets:
        - name: as360-secret
      redisSecretInit:
        enabled: true
        containerSecurityContext:
          runAsUser: 1001
        imagePullSecrets:
        - name: as360-secret
      controller:
        imagePullSecrets:
        - name: as360-secret
  - argocd-image-updater:
      image:
{{- if not (empty $helmRepoRegistry) }}
        repository: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/argocd-image-updater
{{- else }}
        repository: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/argocd-image-updater
{{- end }}
        tag: "v1.1.2-p180"

      imagePullSecrets:
      - name: as360-secret
      config:
        registries:
          - name: sca180acr
{{- if not (empty $helmRepoRegistry) }}
            api_url: http://{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}
            prefix: {{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}
{{- else }}
            api_url: {{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}
            prefix: {{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}
{{- end }}
            defaultns: '{{ .Namespace | default .Values.environment.releaseNamespace }}'
            default: true
            insecure: true
            credentials: pullsecret:{{ .Namespace | default .Values.environment.releaseNamespace }}/sca-harbor-registry-secret

  - scaengineasocintegratorapi:
      common:
        workload:
          volumesAndMounts:
            mountAppSelfIdentityCertificateSecret: false
            mountCustomerCaCertificatesSecret: false
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaservicesecretexternal:
          EncryptionConfiguration__EncryptionKey: "Q3OIv0nz2lApjRM/SVuk9QQ9fwJ0WYYx"
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.AsocIntegratorAPI"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginescanmonitorapi:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanMonitorAPI"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginefetchcve:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.FetchCve"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginescanapi:
      common:
        scapvmountcleanup:
          enabled: false
        workload:
          volumesAndMounts:
            mountAppSelfIdentityCertificateSecret: false
            mountCustomerCaCertificatesSecret: false
        scaascptrigger:
          enabled: false
        scaservicesecretexternal:
          EncryptionConfiguration__EncryptionKey: "Q3OIv0nz2lApjRM/SVuk9QQ9fwJ0WYYx"
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanAPI"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginescanconfig:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanConfig"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginescanhash:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}

  - scaenginescanpostprocessor:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanPostProcessor"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginescanpreprocessor:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanPreprocessor"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaenginesbomreport:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.SbomReport"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaargorepository:
      common:
        scaservicesecrets:
          username: {{ env "SCA_AUTOUPDATER_REGISTRY_USERNAME" | default "" }}
          password: {{ env "SCA_AUTOUPDATER_REGISTRY_PASSWORD" | default "" }}
{{- if not (empty $helmRepoRegistry) }}
          url: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}'
{{- else }}
          url: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default "" }}'
{{- end }}
  - scadprautoupdater:
      common:
        dockerPrivateRegistry:
          secret:
            enabled: true
            helmenabled: false
{{- if not (empty $helmRepoRegistry) }}
            server: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}'
{{- else }}
            server: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}'
{{- end }}

            username: '{{ env "SCA_AUTOUPDATER_REGISTRY_USERNAME" | default "" }}'
            password: '{{ env "SCA_AUTOUPDATER_REGISTRY_PASSWORD" | default "" }}'
            email: ""

  - scaargocveupdater:
      common:
{{- if not (empty $helmRepoRegistry) }}
        AutoUpdaterRegistryServer: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}'
        RepoUrl: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}'
{{- else }}
        AutoUpdaterRegistryServer: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}'
        RepoUrl: {{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}
{{- end }}
{{- if not (empty $helmRepoContext) }}
        AutoUpdaterRegistryPath: '{{ $workloadImageRepository }}'
{{- else }}
        AutoUpdaterRegistryPath: '{{ .Values.environment.dockerRegistryContext }}'
{{- end }}

        namespace: '{{ .Namespace | default .Values.environment.releaseNamespace }}'
        AutoUpdaterHelmPath: '{{ .Values.environment.helmRepositoryContext }}'
        ArgoImageTag: "{{ .Values.environment.autoupdaterImageTag | default "newest-build-2.3.0" }}"
        AutoUpdaterRegistrySecretName: as360-secret
        replicaCount: "1"
        ResourcesLimitsMemory: "3Gi"
        ResourcesLimitsCpu: "2000m"
        ResourcesRequestsMemory: "2.5Gi"
        ResourcesRequestsCpu: "1500m"
        post_sync:
          enabled: true
          post_sync_job_name: "proactive-alert-postsync-trigger"
          pullSecrets:
            - name: as360-secret
          containers:
            - name: "proactive-curl-pod"
              image:
              {{- if not (empty $helmRepoContext) }}
                repository: '{{ $workloadImageRegistry }}/{{ $workloadImageRepository }}/curl'
              {{- else }}
                repository: '{{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/curl'
              {{- end }}
                tag: 8.14.1-p180-2
              cmd: ["curl"]
              args:
                - "-k"
                - "-v"
                - "-X"
                - "POST"
                - "http://engine-asocintegratorapi.{{ .Namespace | default .Values.environment.releaseNamespace }}.svc:18082/api/SecurityIssue/SendProactiveAlert"
                - "-H"
                - "accept: */*"
                - "-d"
                - "{}"
          backoffLimit: 2



  - scaargolibraryupdater:
      common:
{{- if not (empty $helmRepoRegistry) }}
        AutoUpdaterRegistryServer: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}'
        RepoUrl: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default $workloadImageRegistry }}'
{{- else }}
        AutoUpdaterRegistryServer: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}'
        RepoUrl: '{{ env "SCA_AUTOUPDATER_REGISTRY_ADDRESS" | default .Values.environment.dockerRegistryAddress }}'
{{- end }}
{{- if not (empty $helmRepoContext) }}
        AutoUpdaterRegistryPath: '{{ $workloadImageRepository }}'
{{- else }}
        AutoUpdaterRegistryPath: '{{ .Values.environment.dockerRegistryContext }}'
{{- end }}

        AutoUpdaterRegistrySecretName: as360-secret
        namespace: '{{ .Namespace | default .Values.environment.releaseNamespace }}'
        AutoUpdaterHelmPath: '{{ .Values.environment.helmRepositoryContext }}'
        ArgoImageTag: "{{ .Values.environment.autoupdaterImageTag | default "newest-build-2.3.0"}}"
        replicaCount: "1"
        ResourcesLimitsMemory: "2Gi"
        ResourcesLimitsCpu: "1000m"
        ResourcesRequestsMemory: "700Mi"
        ResourcesRequestsCpu: "200m"

  - scacvesearchapi:
      common:
        workload:
          replicaCount: 1
          mainContainer:
            resources:
              limits:
                memory: 3Gi
                cpu: 2000m
              requests:
                memory: 2.5Gi
                cpu: 1500m
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}

  - scalibrarysearchapi:
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}

  - keda:
      enabled: {{ .Values.environment.autoscaling | default "false"}}
      image:
        keda:
{{- if not (empty $helmRepoRegistry) }}
          registry: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}
{{- else }}
          registry: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}
{{- end }}
          repository: keda
          tag: "2.19.0"
        metricsApiServer:
{{- if not (empty $helmRepoRegistry) }}
          registry: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}
{{- else }}
          registry: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}
{{- end }}
          repository: keda-metrics-apiserver
          tag: "2.19.0"
        webhooks:
{{- if not (empty $helmRepoRegistry) }}
          registry: {{ $workloadImageRegistry }}/{{ $workloadImageRepository }}
{{- else }}
          registry: {{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}
{{- end }}
          repository: keda-admission-webhooks
          tag: "2.19.0"
      imagePullSecrets:
      - name: as360-secret

  - manifestbased-library-search:
      enabled: true
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanMonitorAPI"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - manifestbased-library-search-npm:
      enabled: true
      common:
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanMonitorAPI"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}

  - scaegressgatekeeper:
      enabled: true
      common:
        workload:
          mainContainer:
            env:
              additionalEnvs:
              - name: POD_NAME
                valueFrom:
                  fieldRef:
                    fieldPath: metadata.name
              - name: POD_NAMESPACE
                valueFrom:
                  fieldRef:
                    fieldPath: metadata.namespace
              - name: ProxySettings__UpstreamProxy__Host
                value: {{ $upstreamProxyHost | quote }}
              - name: ProxySettings__UpstreamProxy__Port
                value: {{ $upstreamProxyPort | quote }}
              - name: ProxySettings__UpstreamProxy__Username
                value: {{ $upstreamProxyUsername | quote }}
              - name: ProxySettings__UpstreamProxy__Password
                value: {{ $upstreamProxyPassword | quote }}
              - name: Settings__ExternalDomains
                value: ''
              - name: LoggingConfiguration__EnableFileLogging
                value: "true"
              - name: LoggingConfiguration__FileLogPath
                value: "/data/sca180documentstorage/scaegressgatekeeper/"

  - scaenginemanifestbasedcrawler:
      enabled: true
      common:
        scaserviceenv:
          StorageServiceConfiguration__StorageType: "1"
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ManifestBasedCrawler"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}
        keda:
          enabled: false

  - scaenginescanmetadata:
      enabled: true
      common:
        scaserviceenv:
          TelemetryConfiguration__Enabled: {{ $openTelemetryEnable }}
          LoggingConfiguration__EnableOtlpLogging: {{ $openTelemetryEnableLogs }}
          TelemetryConfiguration__MetricsEnabled: {{ $openTelemetryEnableMetrics }}
          TelemetryConfiguration__Otlp__Endpoint: {{ $openTelemetryEndpoint }}
          TelemetryConfiguration__ServiceName: "Engine.ScanMetadata"
          TelemetryConfiguration__AspNetCoreInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__HttpClientInstrumentationEnabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Otlp__Enabled: {{ $openTelemetryEnable }}
          TelemetryConfiguration__Console__Enabled: {{ $openTelemetryEnable }}
          StorageServiceConfiguration__StorageType: "1"
        keda:
          enabled: {{ .Values.environment.autoscaling | default "false"}}
