#
# Prerequisites:
#   (*) Clone the designated AS360 KNI git repository, or pull from the applicable remote repository using the oras CLI tool, and unpack it into the appropriate local directory
#   (*) Ensure you are logged in the designated docker registry (e.g., via using the 'docker login' command),
#       or define 2 environment variables holding the registry credentials: HCLCR_USERNAME and HCLCR_PASSWORD
#   (*) Ensure you are running from a folder that contains the helmfile.d folder
#
# Usage:
#   (*) Install: helmfile sync --state-values-file <path-to-your-values-customization-file (customization file advised name => singular-singular.clusterKit.yaml)>
#     Note: Another option is to use the --values flag instead of the --state-values-file flag
#     Ensure one of the following:
#       1. Define an environment variable as follows:
#         Name: AS360_KNI_JSON_CONFIG_AS_BASE64
#         Value: The designated registry docker config file, encoded in Base64
#       2. Verify an already configured docker config file is residing under the home folder of the user (e.g., ~/.docker/config.json)
#       3. In case the environment variables need to be changed, add another parameter to the command line:
#         --state-values-file <path-to-your-environment-customization-file (customization file advised name => singular-singular.clusterKit.yaml.gotmpl)>
#         3.1. An example of the file content:
            # singular-singular.clusterKit.yaml.gotmpl:
            # -----------------------------------------
            # environment:
            #   helmRepositoryName: "my-custom-helm"
            #   helmRepositoryAddress: "new-helm-registry.local"
            #   helmRepositoryContext: "custom-project/charts"
            #   helmRepositoryOciEnabled: true/false
#   (*) Uninstall: helmfile destroy --state-values-file <path-to-your-values-customization-file (customization file advised name => singular-singular.clusterKit.yaml)>
#   (*) Control the namespace: add the following clause '-n <namespace>' to the helmfile command
#
environments:
  default:
    values:
    - global:
        multiTenantDeploymentDifferentiator: ''
        isNonProductionDeployment: false
        runtime:
          siteName: singular
          clusterName: singular
        workload:
          # container:
          #   image:
          #     registry: hclcr.io
          #     repository: appscan360/as360-k8s-docker-images
          dockerPrivateRegistry:
            externalSecretName: null
    - environment:
        ### ~~~ OVERRIDABLE-SECTION-BEGIN ~~~
        helmRepositoryName: hclcr
        helmRepositoryAddress: hclcr.io
        helmRepositoryContext: appscan360/as360-k8s-helm-packages
        helmRepositoryOciEnabled: true
        releaseName: appscan360-ascp
        releaseVersion: 2.3.0-rhel-fips.85-release-asop
        releaseNamespace: hcl-appscan-ascp
        ### ~~~ OVERRIDABLE-SECTION-END ~~~

---
helmDefaults:
  cleanupOnFail: true
  wait: true
  waitForJobs: true
  timeout: 1800
  createNamespace: true
  deleteWait: true
  syncArgs:
  - "--rollback-on-failure"
  - "--server-side=true"
  - "--force-conflicts"
  - "--reset-values"
  # Note: The destroyArgs section isn't a valid section in this context!!!
  # destroyArgs:
  # - "--skip-charts"
  # - "--skip-deps"
  # - "--skip-refresh"

repositories:
- name: {{ .Values.environment.helmRepositoryName }}
  url: {{ .Values.environment.helmRepositoryAddress }}
  oci: {{ .Values.environment.helmRepositoryOciEnabled }}

releases:
- name: {{ .Values.environment.releaseName }}
  namespace: {{ .Namespace | default .Values.environment.releaseNamespace }}
  chart: {{ .Values.environment.helmRepositoryName }}/{{ .Values.environment.helmRepositoryContext }}/ascp-dart-prime
  version: {{ .Values.environment.releaseVersion }}
  values:
{{/*
  - helmFileCustomizations/{{ .Values.global.runtime.siteName }}-{{ .Values.global.runtime.clusterName }}.clusterKit.yaml
*/}}
  # Converts all your --state-values directly into Helm chart values (replacement of the line above)
  - {{ toYaml .Values | nindent 4 }}
  - global:
      multiTenantDeploymentDifferentiator: {{ .Values.global.multiTenantDeploymentDifferentiator }}
      isOnPremisesDeployment: true
      isOnPremisesDeploymentViaKNI: true
      isNonProductionDeployment: {{ .Values.global.isNonProductionDeployment }}
      runtime:
        customerName: ASOP
        siteName: {{ .Values.global.runtime.siteName }}
        clusterName: {{ .Values.global.runtime.clusterName }}
      workload:
        # container:
        #   image:
        #     registry: {{ .Values.global.workload.container.image.registry }}
        #     repository: {{ .Values.global.workload.container.image.repository }}
{{- if empty .Values.global.workload.dockerPrivateRegistry.externalSecretName }}
        dockerPrivateRegistry:
          secret:
            data:
  {{- if env "AS360_KNI_JSON_CONFIG_AS_BASE64" }}
              jsonConfigAsBase64: {{ env "AS360_KNI_JSON_CONFIG_AS_BASE64" }}
  {{- else }}
              jsonConfigAsBase64: {{ readFile (printf "%s/%s" (env "HOME") ".docker/config.json") | b64enc }}
  {{- end }}
{{- end }}
{{/*
- name: reloader
  namespace: '{{ .Namespace | default .Values.environment.releaseNamespace }}'
{{- if ne .Environment.Name "as360-dev" }}
  chart: '{{ .Values.environment.helmRepositoryName }}/{{ .Values.environment.helmRepositoryContext }}/reloader'
  version: 1.2.1
{{- else }}
  chart: stakater/reloader
  version: 1.2.1
{{- end }}
  needs:
  - '{{ .Values.environment.releaseName }}'
  values:
  - global:
      imagePullSecrets:
      - name: {{ ternary .Values.global.workload.dockerPrivateRegistry.externalSecretName .Values.global.workload.dockerPrivateRegistry.secret.name (not (empty .Values.global.workload.dockerPrivateRegistry.externalSecretName)) }}
    reloader:
      watchGlobally: false
      deployment:
{{- if ne .Environment.Name "as360-dev" }}
        image:
          name: '{{ .Values.environment.dockerRegistryAddress }}/{{ .Values.environment.dockerRegistryContext }}/reloader'
          tag: v1.2.1
{{- else }}
        image:
          tag: v1.2.1
{{- end }}
        containerSecurityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
    # WA for a defect in the latest chart!
    nameOverride: reloader
    fullnameOverride: reloader
*/}}