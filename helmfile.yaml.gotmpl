helmfiles:
  - path: ./helm.d/ascp/helmfile.yaml.gotmpl
    values:
      - {{ toYaml .Values | nindent 8 }}
  - path: ./helm.d/asra/helmfile.yaml.gotmpl
    values:
      - {{ toYaml .Values | nindent 8 }}
{{- if ne (env "excludeDTCS") "true" }}
  - path: ./helm.d/dtcs/helmfile.yaml.gotmpl
    values:
      - {{ toYaml .Values | nindent 8 }}
{{- end }}
{{- if eq (env "includeSCA") "true" }}
  - path: ./helm.d/sca/helmfile.yaml.gotmpl
    values:
      - {{ toYaml .Values | nindent 8 }}
{{- end }}